# OpenViva Root Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.

GPU_SERVER_IP=127.0.0.1
GPU_SSH_USER=your_username
GPU_SSH_PASS=your_password

# LiveKit Real-Time WebRTC Credentials
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# vLLM / OpenAI Compatible Endpoint
VLLM_API_URL=http://127.0.0.1:8000/v1
VLLM_MODEL=thesven/Phi-3.5-mini-instruct-awq
NEXT_PUBLIC_VLLM_MODEL=thesven/Phi-3.5-mini-instruct-awq

# S3 / MinIO Object Storage
S3_ENDPOINT=http://127.0.0.1:9000
INTERNAL_S3_ENDPOINT=http://minio:9000
S3_BUCKET=viva-recordings
S3_ACCESS_KEY=your_minio_access_key
S3_SECRET_KEY=your_minio_secret_key
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# Security Keys
INTERNAL_SERVICE_KEY=your_internal_service_key_at_least_32_chars
