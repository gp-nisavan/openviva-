# OpenViva Web Frontend Environment Configuration Template
# Copy this file to .env.local and fill in your actual credentials.

NEXT_PUBLIC_BASE_PATH=/openviva
PORT=3001
HOSTNAME=0.0.0.0

# LiveKit Real-Time WebRTC Credentials
LIVEKIT_URL=http://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# vLLM LLM Endpoint
VLLM_API_URL=http://127.0.0.1:8000/v1
VLLM_MODEL=thesven/Phi-3.5-mini-instruct-awq
NEXT_PUBLIC_VLLM_MODEL=thesven/Phi-3.5-mini-instruct-awq

# Authentication & Internal Tokens
INITIAL_ADMIN_KEY=your_initial_admin_key_here
INTERNAL_SERVICE_KEY=your_internal_service_key_at_least_32_chars
